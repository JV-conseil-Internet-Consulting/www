{% if plugins contains 'jekyll-feed' %}
  {% include head/feed-tag.liquid %}{% endif %}

<link rel="shortcut icon" href="{{ site.favicon          | default:'/assets/icons/favicon.ico'       | relative_url }}">
<link rel="apple-touch-icon" href="{{ site.apple_touch_icon | default:'/assets/icons/favicon-192x192.png'  | relative_url }}">

<link rel="manifest" href="{{ '/assets/site.webmanifest' | relative_url }}">

{% if site.google_fonts and site.fonts_css == nil %}
  {%- capture google_fonts_url %}
    {{ site.google_fonts_url | default: 'https://fonts.googleapis.com' }}{%- endcapture -%}
  {#-
    PageSpeed Insights (mobile report, 2026-11-15) lists no preconnected
    origins and names the Google Fonts WOFF2 files among the layout-shift
    culprits. Upgrading the hints from dns-prefetch to preconnect removes
    the DNS + TCP + TLS setup from the font request chain. The CSS request
    to googleapis.com is a plain no-CORS request, so it must not carry
    `crossorigin`; the WOFF2 requests to gstatic.com are anonymous CORS
    requests and require `crossorigin` for the pre-opened connection to match.
  -#}
  <link rel="preconnect" href="{{ google_fonts_url }}">
  {%- if google_fonts_url == 'https://fonts.googleapis.com' -%}
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- endif -%}
{% endif %}

{% if site.google_analytics %}
  <link rel="dns-prefetch" href="https://www.google-analytics.com">
{% endif %}

<link
  rel="preload"
  href="{{ '/assets/img/swipe.svg' | relative_url }}"
  as="image"
  id="_hrefSwipeSVG">

<link
  rel="dns-prefetch"
  href="{{ '/assets/js/search-worker-deepdive-9.1.7.min.js' | relative_url }}"
  as="worker"
  id="_hrefSearch">

{% comment %}
  <!--
  PageSpeed Insights (mobile report, 2026-11-15) for
  /blog/2026-10-27-funding-apps-danish-universities-7-years-collaboration/
  fetches the ES module bundle at the lowest network priority, so on slow
  connections it arrives after the stylesheets, fonts and images
  (~2.2 s on emulated slow 4G) even though the LCP paint is gated behind it
  (LCP breakdown: element render delay 2,000 ms; "Network dependency tree":
  HTML -> deepdive-9.1.7.min.js, 421 ms; module long task at 2,251 ms).

  `rel="modulepreload"` promotes the module (and the chunks that define the
  `hy-drawer` / `hy-push-state` web components) to preload priority, so the
  bundle is fetched with the first wave of resources and executes as soon as
  the CPU is free instead of after every other download. Browsers without
  module support ignore the hint and keep the `nomodule` fallback; module
  capable browsers deduplicate the preload against the module script tag, so
  the bundle is downloaded once.
  -->
{% endcomment %}
<link
  rel="modulepreload"
  href="{{ '/assets/js/deepdive-9.1.7.min.js' | relative_url }}">
<link
  rel="modulepreload"
  href="{{ '/assets/js/drawer-deepdive-9.1.7.min.js' | relative_url }}">
<link
  rel="modulepreload"
  href="{{ '/assets/js/push-state-deepdive-9.1.7.min.js' | relative_url }}">

{% if site.kramdown.math_engine == 'katex' %}
  {% capture katex_url %}
    {{ 'assets/bower_components/katex/dist/katex.min.css' | relative_url }}{% endcapture %}
  <link
    rel="dns-prefetch"
    href="{{ katex_url }}"
    id="_katexPreload">
  <noscript><link rel="stylesheet" href="{{ katex_url }}"></noscript>
{% endif %}

{% assign disqus = site.disqus | default: site.disqus_shortname %}
{% if disqus %}
  <link
    rel="dns-prefetch"
    href="https://{{ disqus }}.disqus.com"
    id="_hrefDisqus">
{% endif %}
