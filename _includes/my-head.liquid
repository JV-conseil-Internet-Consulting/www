{% include_cached my-content-security-policy.liquid %}

{% comment %}
  <!--
  Preconnect to the third-party origins of the badge widgets (WakaTime
  activity SVG, shields.io badges). PageSpeed Insights (report of
  2026-11-15, 9orl0p42um) lists both as preconnect candidates: the DNS +
  TCP + TLS handshake happens during the otherwise idle time while the
  first-party resources load, removing connection setup from the first
  render of those images. Keep the number of preconnect hints at four or
  fewer.
  -->
{% endcomment %}
<link rel="preconnect" href="https://github-readme-stats.vercel.app">
<link rel="preconnect" href="https://img.shields.io">
<link rel="preconnect" href="https://wakatime.com">

{% comment %}
  <!--
  Preload the post's lead image to improve the Largest Contentful Paint (LCP).
  The image is rendered above the fold by _includes/components/post.liquid.
  Pages without hide_image are preloaded, with imagesrcset/imagesizes matching
  the rendered img when the image declares a srcset (see components/hy-img.liquid).
  -->
{% endcomment %}
{% if page.layout == 'post' and page.image and page.hide_image != true %}
  {% assign hy_preload_src = page.image.path | default: page.image %}
    {% if hy_preload_src and page.image.srcset %}
  {% capture hy_preload_srcset %}{% for hash in page.image.srcset %}{% assign tmp = hash[1] %}{% include_cached smart-url url=tmp %} {{ hash[0] }}{% unless forloop.last %},{% endunless %}{% endfor %}{% endcapture %}
    {% comment %}
      Mirror the `sizes` attribute rendered by components/hy-img.liquid for the post
      hero (see components/post.liquid) so the preload and the <img> resolve to the
      same srcset candidate and the image is fetched only once.
    {% endcomment %}
    {% assign hy_vars = site.data.variables %}
    {% capture hy_preload_sizes %}
      (min-width: {{ hy_vars.break_point_5 | default: 86 }}em) {{ hy_vars.content_width_5 | default: 54 | plus: 2 }}rem,
      (min-width: {{ hy_vars.break_point_2 | default: 54 }}em) {{ hy_vars.content_width_2 | default: 48 | plus: 2 }}rem,
      (min-width: {{ hy_vars.break_point_1 | default: 42 }}em) {{ hy_vars.content_width | default: 42 | plus: 2 }}rem,
      100vw
    {% endcapture %}
    {% assign hy_preload_sizes = hy_preload_sizes | strip_newlines | replace: ' ', '' %}
    <link
      rel="preload"
      as="image"
      href="{{ hy_preload_src | relative_url }}"
      imagesrcset="{{ hy_preload_srcset | strip }}"
      imagesizes="{{ hy_preload_sizes }}"
      fetchpriority="high">
  {% elsif hy_preload_src %}
    <link
      rel="preload"
      as="image"
      href="{{ hy_preload_src | relative_url }}"
      fetchpriority="high">
  {% endif %}
{% endif %}

{% comment %}
  <!--
  Preload the sidebar background image on cover pages (e.g. the homepage).
  On cover pages the drawer starts `opened` and its background image is the
  Largest Contentful Paint element; PageSpeed Insights (report of 2026-11-15)
  measured a 1,320 ms resource load delay because the image was lazy-loaded
  and only discovered late. The preload makes the request discoverable from
  the initial HTML at high priority. _includes/body/sidebar-bg.liquid renders
  the matching <img> eager with `fetchpriority="high"`.

  When the cover image is the site-wide accent image, the <img> carries a
  srcset; `imagesrcset`/`imagesizes` must mirror it exactly (same candidates,
  same order, same `sizes`), so the preload and the <img> deduplicate into a
  single download. `href` remains the fallback for browsers without
  `imagesrcset` support.

  Only plain-string accent images are preloaded: when `accent_image` is set
  to the object form (with a `.background` property) the sidebar uses a CSS
  background instead of an <img>, so there is no LCP image to preload.
  -->
{% endcomment %}
{% if page.cover %}
  {% assign hy_cover_img = page.accent_image | default: site.accent_image %}
  {% if hy_cover_img and hy_cover_img.background == nil %}
    {%- capture hy_cover_img_url -%}{% include_cached smart-url url=hy_cover_img %}{%- endcapture -%}
    {% if hy_cover_img == site.accent_image %}
      {%- assign hy_cover_img_1464 = site.accent_image | replace_first: '.webp', '-1464x823.webp' -%}
      {%- capture hy_cover_img_1464_url -%}{% include_cached smart-url url=hy_cover_img_1464 %}{%- endcapture -%}
      <link
        rel="preload"
        as="image"
        href="{{ hy_cover_img_url | strip }}"
        imagesrcset="{{ hy_cover_img_1464_url | strip }} 1464w, {{ hy_cover_img_url | strip }} 3280w"
        imagesizes="100vw"
        fetchpriority="high">
    {% else %}
      <link
        rel="preload"
        as="image"
        href="{{ hy_cover_img_url | strip }}"
        fetchpriority="high">
    {% endif %}
  {% endif %}
{% endif %}

{% comment %}
  <!--
  Preload the word cloud banner to improve the Largest Contentful Paint (LCP)
  on the pages that render it (layouts `welcome` and `about`, see
  _includes/my-description.liquid): on the homepage it is the LCP element.
  The imagesrcset/imagesizes mirror the rendered <img> exactly (same
  candidates, same order, same `sizes`) so the preload and the <img>
  deduplicate into a single download; `href` is the fallback for browsers
  without `imagesrcset` support and matches the <img> src.
  -->
{% endcomment %}
{% if page.layout == 'welcome' or page.layout == 'about' %}
  <link
    rel="preload"
    as="image"
    href="{{ '/assets/img/nuage-de-mots-1600x400.webp' | relative_url }}"
    imagesrcset="{{ '/assets/img/nuage-de-mots-375x94.webp' | relative_url }} 375w, {{ '/assets/img/nuage-de-mots-450x113.webp' | relative_url }} 450w, {{ '/assets/img/nuage-de-mots-768x192.webp' | relative_url }} 768w, {{ '/assets/img/nuage-de-mots-900x225.webp' | relative_url }} 900w, {{ '/assets/img/nuage-de-mots-1600x400.webp' | relative_url }} 1600w"
    imagesizes="(min-width: 86em) 54rem, (min-width: 54em) 48rem, (min-width: 42em) 42rem, 100vw"
    fetchpriority="high">
{% endif %}

{% comment %}
  <!--
  Using preload so that page rendering doesn't get blocked.
  Fill in href. You may have to adjust as and onload/rel, depending on content.

  <link href="<path/to/content.css>" rel="preload" as="style" onload="this.rel='stylesheet'">

  Fallback in case JavaScript isn't enabled.
  Fill in href. You may have to adjust rel.

  <noscript><link href="<path/to/content.css>" rel="stylesheet"></noscript>
  -->
{% endcomment %}