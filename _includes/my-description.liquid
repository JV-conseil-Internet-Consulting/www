{% assign author = site.data.authors[include.author] | default: site.data.authors.first[1] | default: site.author %}

  {% if include.banner != false %}

  {% comment %}
    <!--
    PageSpeed Insights (report of 2026-11-15) flags the word cloud in
    "Improve image delivery": the 1600x400 file (112 KiB) is served for a
    ~375x94 mobile display. The explicit width/height attributes reserve
    the 4:1 aspect-ratio box before the image loads, and the srcset serves
    the existing 450w Git LFS variant (23 KiB) to standard-density
    viewports; the sizes attribute mirrors the theme content column widths
    from _data/variables.yml (42/48/54rem at the 42/54/86em breakpoints).
    Hi-DPI phones (DPR 1.75+) still resolve to the 1600w candidate
    because 450x1.75 < 656px; clearing them requires a ~900w candidate
    generated from the source PNG with:
    cwebp -resize 900 225 -q 60 nuage-de-mots.png -o nuage-de-mots-900x225.webp
    cwebp -resize 375 94 -q 60 nuage-de-mots.png -o nuage-de-mots-375x94.webp
    (a Git LFS binary) and declared in the srcset below.
    -->
  {% endcomment %}
  <img
    src="/assets/img/nuage-de-mots-1600x400.webp"
    srcset="/assets/img/nuage-de-mots-375x94.webp 375w, /assets/img/nuage-de-mots-450x113.webp 450w, /assets/img/nuage-de-mots-900x225.webp 900w, /assets/img/nuage-de-mots-1600x400.webp 1600w"
    sizes="(min-width: 86em) 54rem, (min-width: 54em) 48rem, (min-width: 42em) 42rem, 100vw"
    width="1600"
    height="400"
    decoding="async"
    style="max-width:100%;height:auto"
    alt="DevOps • Full Stack Developer • Web App Architect • Python 🐍 Django • PostgreSQL 🐘 JavaScript • Node.js • Azure Cloud ☁️ NLP (Natural Language Processing) • ETL Developer (Extract, Transform, Load) • Paris, France 🇫🇷">

---

{% endif %}

