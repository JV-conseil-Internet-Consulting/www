{% include body/analytics_gdpr_compliant.liquid %}
<script type="module">
  if ('serviceWorker' in navigator) {
    /*{% if site.deepdive.offline.enabled %}*/
    navigator.serviceWorker
      .register('{{ "/sw.js" | relative_url }}')
      .then(r => r.update())
      .catch(() => {});
    /*{% else %}*/
    navigator.serviceWorker.getRegistration()
      .then(r => r.unregister())
      .catch(() => {});
    /*{% endif %}*/
  }
</script>
